# Review routing. Later matches win; see GOVERNANCE.md.
# The maintainers team is on everything. The sensitive paths are listed again at the end
# so they stay maintainer-reviewed even if a broader rule above is ever changed.
*                       @codeatlasdev/atlas-maintainers
/crates/                @codeatlasdev/atlas-maintainers
/apps/desktop/          @codeatlasdev/atlas-maintainers
/site/                  @codeatlasdev/atlas-maintainers
/studio/                @codeatlasdev/atlas-maintainers
/docs/                  @codeatlasdev/atlas-maintainers
/skills/                @codeatlasdev/atlas-maintainers
/LICENSE-*              @codeatlasdev/atlas-maintainers
/SECURITY.md            @codeatlasdev/atlas-maintainers
/GOVERNANCE.md          @codeatlasdev/atlas-maintainers
/CONTRIBUTING.md        @codeatlasdev/atlas-maintainers

# Sensitive: CI and rulesets, releases, the host daemon, agent rules.
/.github/               @codeatlasdev/atlas-maintainers
/.agents/               @codeatlasdev/atlas-maintainers
/scripts/release*       @codeatlasdev/atlas-maintainers
/crates/atlas-host/     @codeatlasdev/atlas-maintainers
/AGENTS.md              @codeatlasdev/atlas-maintainers

# Translations: a native speaker of the language reads every change (docs/contributing.md,
# "Translating Atlas"). pt-BR is a required language; its owners are the maintainers who speak it.
# `bun run i18n:add-locale <tag>` adds the two lines for a new language.
**/pt-BR/**                  @mvilacad @luancoleto
/i18n/messages/*/pt-BR.json  @mvilacad @luancoleto
/i18n/glossary.yaml          @codeatlasdev/atlas-maintainers
/i18n/style/                 @codeatlasdev/atlas-maintainers
