# SvelteKit build output (static adapter, bundled by Tauri) and generated state
.svelte-kit
build
node_modules
# Generated by scripts/gen-icons.ts (`bun run icons`); never edit by hand
src/lib/icon-data/
# Generated by scripts/paraglide.ts (`bun run i18n:compile`; vite recompiles on every catalog edit); never edit by hand
src/lib/paraglide/

# Generated by `bun run i18n:generate` from i18n/messages (the one source tree); the input of Paraglide, never committed
.i18n/

# Generated by scripts/paraglide.ts: Paraglide messages with the OS input added; never committed
src/lib/i18n/messages.gen.ts
