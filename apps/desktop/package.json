{
  "name": "atlas-desktop",
  "description": "Atlas Desktop UI: the native workspace of the developer platform for everyone (SvelteKit + @codeatlasdev/ui)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run icons && vite dev",
    "build": "bun run icons && vite build",
    "format": "prettier --write src",
    "lint": "prettier --check src",
    "check": "bun run icons && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check src && bun test src",
    "icons": "bun scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "material-icon-theme": "^5.39.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@codeatlasdev/ui": "^0.7.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.55.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "echarts": "^6.1.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "shiki": "^4.5.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "license": "MIT OR Apache-2.0",
  "homepage": "https://atlas.codeatlas.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeatlasdev/atlas.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/codeatlasdev/atlas/issues"
  }
}
