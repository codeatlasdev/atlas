{
  "name": "atlas-desktop",
  "description": "Atlas Desktop UI: the native workspace of the developer platform for everyone (SvelteKit + @codeatlasdev/ui)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run icons && vite dev",
    "build": "bun run icons && vite build",
    "format": "prettier --write src",
    "lint": "prettier --check src",
    "check": "bun run icons && bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check src && bun run test && bun run bundle",
    "bundle": "bun ../../scripts/bundle-budget.ts",
    "test": "TZ=UTC LC_ALL=en_US.UTF-8 bun test --conditions browser --parallel --timeout 60000 src",
    "icons": "bun scripts/gen-icons.ts",
    "i18n:compile": "bun scripts/paraglide.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "material-icon-theme": "^5.40.0",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codeatlasdev/ui": "^4.6.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.79.0",
    "@tauri-apps/api": "^2.12.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "echarts": "^6.1.0",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "simple-icons": "^16.38.1",
    "smol-toml": "^1.9.1",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "license": "MIT OR Apache-2.0",
  "homepage": "https://atlas.codeatlas.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeatlasdev/atlas.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/codeatlasdev/atlas/issues"
  }
}
