<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher masks it to its own shape (no white circle
     around a shrunken square). Background: the gradient; foreground: the globe, sized
     inside the 66 % safe zone like on iOS, so no mask crops it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
