# Atlas Mobile to testers and then to the stores: TestFlight (iOS) and the Play internal testing
# track (Android) from one command (`bun run mobile:beta`, or the `Mobile release` workflow), then,
# after a maintainer approves that same build, App Store review and Play production. Credentials
# come from the environment only; nothing secret is in the repo. docs/mobile.md, "Releases",
# lists them.
#
#   fastlane beta             both stores' test tracks, one build number
#   fastlane ios_beta         TestFlight only
#   fastlane android_beta     Play internal testing only
#   fastlane release          promote BUILD_NUMBER (already tested) to both stores
#   fastlane ios_release      submit that TestFlight build to App Store review
#   fastlane android_release  promote that internal build to Play production
#   fastlane ios_rehearse     the iOS store build, unsigned, never uploaded (pull requests)
#   fastlane android_rehearse the Android store bundle, debug-signed, never uploaded (pull requests)

default_platform(:ios)

APP = File.expand_path("..", __dir__) # apps/mobile
ANDROID_PACKAGE = "br.com.codeatlas.atlas.mobile"
IOS_BUNDLE_ID = "br.com.codeatlas.atlas.mobile"

BETA_DESCRIPTION = <<~TEXT.strip
  Atlas on your phone: see and control the Atlas running on your computer, from anywhere and
  with no account. Pair with the QR code in Atlas Desktop (Settings, Mobile), then follow your
  projects, services and logs, talk to your agents and answer their permission prompts.
TEXT

# One build number for both stores, increasing on every run: minutes since the Unix epoch
# (~29 million, well under Play's 2.1 billion limit). BUILD_NUMBER overrides it.
def build_number
  (ENV["BUILD_NUMBER"] || (Time.now.to_i / 60)).to_s
end

# The version users see (1.2.0): VERSION (the workflow takes it from the `mobile-v1.2.0` tag),
# else the one in pubspec.yaml.
def version_name
  v = ENV["VERSION"].to_s.strip
  return v unless v.empty?
  File.read(File.join(APP, "pubspec.yaml"))[/^version:\s*([0-9.]+)/, 1]
end

def need(*names)
  missing = names.reject { |n| ENV[n] && !ENV[n].empty? }
  UI.user_error!("missing #{missing.join(', ')} (docs/mobile.md, \"Releases\")") unless missing.empty?
end

def flutter(*args)
  sh("flutter", *args, log: true) # sh runs from fastlane/; Flutter needs the app dir
end

# The translations are not committed: the ARB files come from the one catalog (i18n/messages, the `mobile` surface)
# and `flutter pub get` turns them into lib/l10n/app_localizations.dart. Every store build starts here.
def write_translations
  sh("bun", File.join(APP, "../../scripts/i18n/generate.ts"), "--surface", "mobile", log: true)
  flutter("pub", "get")
end

# What every store build passes to `flutter build`. The pubspec's default flavor is the Atlas Dev app, so the
# store app is always asked for by name (`prod`: br.com.codeatlas.atlas.mobile). The Dart symbols go to a
# directory instead of the binary (smaller App.framework / libapp.so); CI keeps that directory as an artifact
# (`flutter symbolize` needs it for a stack trace). Names are kept readable (no --obfuscate).
def store_build_args(platform, n)
  ["--release", "--flavor", "prod", "--split-debug-info=build/symbols/#{platform}",
   "--build-number=#{n}", "--build-name=#{version_name}"]
end

# Firebase config (push): CI hands it over as secrets; the files are written only for the build and
# deleted right after, never committed (apps/mobile/.gitignore lists both). Without the secret the
# app builds with no push. Returns the path when written, else nil.
def write_firebase_config(relative_path, env_name)
  value = ENV[env_name].to_s
  return nil if value.strip.empty?
  path = File.join(APP, relative_path)
  File.write(path, value)
  path
end

lane :beta do
  n = build_number
  ios_beta(build_number: n)
  android_beta(build_number: n)
end

# The TestFlight groups a build must be handed to. A group with access to all builds already gets every
# build once it is processed, and App Store Connect refuses to assign one to it ("Builds cannot be assigned
# to this internal group", mobile-v1.0.1), so those are left out. Needs the API key set first.
def assignable_groups(names)
  return [] if names.empty?
  app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
  UI.user_error!("no App Store Connect app #{IOS_BUNDLE_ID}") unless app
  by_name = app.get_beta_groups.to_h { |g| [g.name, g] }
  unknown = names - by_name.keys
  UI.user_error!("unknown TestFlight groups: #{unknown.join(', ')}") unless unknown.empty?
  automatic, manual = names.partition { |name| by_name[name].has_access_to_all_builds }
  UI.message("TestFlight: #{automatic.join(', ')} get every build automatically") unless automatic.empty?
  manual
end

lane :ios_beta do |options|
  need("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8", "APPLE_TEAM_ID")
  n = options[:build_number] || build_number
  # Internal groups only: external testers need Apple's beta review (and a way to try the
  # app without a computer running Atlas).
  groups = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
  # Handing a build to a group needs the app's beta information (description AND feedback email):
  # without the email fastlane reports it "set" but creates no localization, and App Store Connect
  # refuses the distribution after a 25-minute build ("Beta App Description is missing"). Checked here,
  # before anything is built.
  need("BETA_FEEDBACK_EMAIL") unless groups.empty?
  key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
  )
  groups = assignable_groups(groups)
  # xcodebuild signs with the same key (automatic signing, no certificates in the repo).
  p8 = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  File.write(p8, ENV["ASC_KEY_P8"])
  plist = write_firebase_config("ios/GoogleService-Info.plist", "GOOGLE_SERVICE_INFO_PLIST")
  Dir.chdir(APP) do
    write_translations
    flutter("build", "ios", "--no-codesign", *store_build_args("ios", n))
  end
  # Archive and export both sign through the API key (role Admin: creating the cloud-managed
  # distribution certificate needs it): with -allowProvisioningUpdates Xcode
  # uses Apple's cloud-managed distribution certificate, so no certificate lives anywhere.
  auth = [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{p8}",
    "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
    "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
  ].join(" ")
  ipa = build_app(
    workspace: File.join(APP, "ios/Runner.xcworkspace"),
    scheme: "prod", # the store app: the Release configuration, id br.com.codeatlas.atlas.mobile
    export_method: "app-store",
    output_directory: File.join(APP, "build/fastlane"),
    # fastlane hands xcargs to the export too (a second copy is refused).
    xcargs: "#{auth} DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
    export_options: { signingStyle: "automatic", teamID: ENV["APPLE_TEAM_ID"] },
  )
  upload_to_testflight(
    api_key: key,
    ipa: ipa,
    groups: groups.empty? ? nil : groups,
    skip_waiting_for_build_processing: groups.empty?,
    # TestFlight asks for these before handing a build to a group.
    beta_app_description: BETA_DESCRIPTION,
    beta_app_feedback_email: ENV["BETA_FEEDBACK_EMAIL"],
    changelog: ENV.fetch("BETA_CHANGELOG", "New test build."),
    # The groups are internal (see above), and internal testers need no beta review. pilot submits one
    # by default, which fails without the beta review contact ("Missing required information to submit
    # for external testing"), after the build is already uploaded (mobile-v1.0.1).
    submit_beta_review: false,
  )
ensure
  [p8, plist].each { |f| File.delete(f) if f && File.exist?(f) }
end

lane :android_beta do |options|
  need("PLAY_SERVICE_ACCOUNT_JSON", "ANDROID_KEYSTORE_BASE64", "ANDROID_KEYSTORE_PASSWORD",
       "ANDROID_KEY_ALIAS")
  n = options[:build_number] || build_number
  props = File.join(APP, "android/key.properties")
  jks = File.join(Dir.tmpdir, "atlas-upload.jks")
  File.binwrite(jks, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"]))
  File.write(props, <<~PROPS)
    storeFile=#{jks}
    storePassword=#{ENV['ANDROID_KEYSTORE_PASSWORD']}
    keyAlias=#{ENV['ANDROID_KEY_ALIAS']}
    keyPassword=#{ENV['ANDROID_KEY_PASSWORD'] || ENV['ANDROID_KEYSTORE_PASSWORD']}
  PROPS
  gservices = write_firebase_config("android/app/google-services.json", "GOOGLE_SERVICES_JSON")
  Dir.chdir(APP) do
    write_translations
    flutter("build", "appbundle", *store_build_args("android", n))
  end
  upload_to_play_store(
    package_name: ANDROID_PACKAGE,
    track: "internal",
    aab: File.join(APP, "build/app/outputs/bundle/prodRelease/app-prod-release.aab"),
    json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
  )
ensure
  [props, jks, gservices].each { |f| File.delete(f) if f && File.exist?(f) }
end

# The store half: never builds. It promotes the exact build testers had (BUILD_NUMBER), so what
# reaches the public is what was tested.
lane :release do
  ios_release
  android_release
end

# Submit the TestFlight build BUILD_NUMBER (version VERSION) to App Store review; Apple releases it
# on approval. Store texts and screenshots are kept in App Store Connect for now.
lane :ios_release do
  need("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8", "BUILD_NUMBER")
  upload_to_app_store(
    api_key: app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    ),
    app_version: version_name,
    build_number: ENV["BUILD_NUMBER"],
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    submit_for_review: true,
    automatic_release: true,
    # precheck cannot read in-app purchases through an API key and fails the whole submission on it
    # (the app has none).
    precheck_include_in_app_purchases: false,
    # Export compliance: the app's Info.plist already says ITSAppUsesNonExemptEncryption = NO.
    submission_information: { export_compliance_uses_encryption: false },
    force: true,
  )
end

# Move the internal-testing build BUILD_NUMBER to production, to every user at once.
#
# An app that was never published is a "draft app" for Play, and the API refuses to roll anything out
# on it ("Only releases with status draft may be created on draft app"). Its first production release
# is therefore created as a draft and sent to review from Play Console (Publishing overview → Send for
# review); every later release goes out completed from here.
lane :android_release do
  need("PLAY_SERVICE_ACCOUNT_JSON", "BUILD_NUMBER")
  promote = lambda do |status|
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      track: "internal",
      track_promote_to: "production",
      version_code: ENV["BUILD_NUMBER"].to_i,
      track_promote_release_status: status,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
  begin
    promote.call("completed")
  rescue StandardError => e
    raise unless e.message =~ /draft app/i
    promote.call("draft")
    UI.important("Play: first production release created as a DRAFT (the app was never published). " \
                 "Finish it once in Play Console: Publishing overview → Send for review.")
  end
end

# Rehearsal (pull requests that touch the release path, `.github/workflows/mobile-release.yml`): the
# store builds exactly as a release makes them (same flavor, flags and symbols), but unsigned and never
# uploaded, with no secret at all. A break in the store build shows up on the PR, not on a release tag.
lane :ios_rehearse do
  Dir.chdir(APP) do
    write_translations
    flutter("build", "ios", "--no-codesign", *store_build_args("ios", build_number))
  end
  build_app(
    workspace: File.join(APP, "ios/Runner.xcworkspace"),
    scheme: "prod",
    skip_codesigning: true,
    skip_package_ipa: true,
    archive_path: File.join(APP, "build/fastlane/Runner.xcarchive"),
    xcargs: "CODE_SIGNING_ALLOWED=NO",
  )
end

lane :android_rehearse do
  Dir.chdir(APP) do
    write_translations
    # No key.properties: build.gradle.kts signs with the debug key, which is enough to prove the bundle builds.
    flutter("build", "appbundle", *store_build_args("android", build_number))
  end
  aab = File.join(APP, "build/app/outputs/bundle/prodRelease/app-prod-release.aab")
  UI.user_error!("no bundle at #{aab}") unless File.exist?(aab)
end

# Hand an already uploaded iOS build to the TestFlight groups (e.g. after fixing what blocked
# the distribution). BUILD_NUMBER and VERSION name it.
lane :ios_distribute do
  need("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8", "BUILD_NUMBER", "TESTFLIGHT_GROUPS")
  key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
  )
  groups = assignable_groups(ENV["TESTFLIGHT_GROUPS"].split(",").map(&:strip).reject(&:empty?))
  next UI.success("Nothing to hand over: every group gets new builds automatically") if groups.empty?
  upload_to_testflight(
    api_key: key,
    distribute_only: true,
    app_platform: "ios",
    app_version: ENV.fetch("VERSION", "1.0.0"),
    build_number: ENV["BUILD_NUMBER"],
    groups: groups,
    beta_app_description: BETA_DESCRIPTION,
    beta_app_feedback_email: ENV["BETA_FEEDBACK_EMAIL"],
    changelog: ENV.fetch("BETA_CHANGELOG", "New test build."),
    submit_beta_review: false, # internal groups only, as in ios_beta
  )
end
