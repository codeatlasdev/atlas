{
	"name": "panel",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun run src/index.ts",
		"check-types": "tsc --noEmit",
		"seed": "bun run src/seed.ts"
	},
	"dependencies": {
		"@atlas/api": "workspace:*",
		"@atlas/auth": "workspace:*",
		"@atlas/cloudflare": "workspace:*",
		"@atlas/crypto": "workspace:*",
		"@atlas/db": "workspace:*",
		"@atlas/env": "workspace:*",
		"@atlas/kubernetes": "workspace:*",
		"@atlas/provisioner": "workspace:*",
		"@atlas/ssh": "workspace:*",
		"@elysiajs/cors": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"drizzle-orm": "catalog:",
		"elysia": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@atlas/config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
