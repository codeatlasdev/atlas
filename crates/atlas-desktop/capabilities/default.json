{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main",
    "tray",
    "dock",
    "shots-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:default",
    "shell:allow-open",
    "window-state:default",
    "notification:default"
  ]
}
