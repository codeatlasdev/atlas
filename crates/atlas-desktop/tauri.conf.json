{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "identifier": "dev.codeatlas.atlas",
  "build": {
    "frontendDist": "../../apps/desktop/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../apps/desktop dev",
    "beforeBuildCommand": "bun run --cwd ../apps/desktop build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Atlas",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 21
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "The developer platform for everyone",
    "longDescription": "Atlas Desktop is the native workspace of the Atlas developer platform: one atlas.yaml runs your stack, and a GPU terminal, git worktrees, diff review and an embedded browser run your coding agents in parallel.",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
