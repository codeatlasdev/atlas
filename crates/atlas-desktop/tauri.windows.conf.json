{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Atlas",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "publisher": "CodeAtlas",
    "copyright": "© CodeAtlas. MIT OR Apache-2.0.",
    "homepage": "https://atlas.codeatlas.com.br",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "../../packaging/windows/installer-header.bmp",
        "sidebarImage": "../../packaging/windows/installer-sidebar.bmp",
        "startMenuFolder": "Atlas",
        "compression": "lzma"
      }
    }
  }
}
