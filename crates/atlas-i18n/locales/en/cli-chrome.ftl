# The words clap prints around the help of every migrated command. They mirror clap's English
# defaults; the English catalog documents them, and clap itself prints them when the language is en.

# Heading before the usage line of `--help`, e.g. "Usage: atlas config lang [TAG]". Keep the colon:
# it is part of this message, unlike the section headings below.
cli-chrome-usage = Usage:

# Section heading for the subcommands in `--help`. No colon: clap adds it.
cli-chrome-commands = Commands

# Section heading for positional arguments in `--help`. No colon: clap adds it.
cli-chrome-arguments = Arguments

# Section heading for flags and options in `--help`. No colon: clap adds it.
cli-chrome-options = Options

# Help text of the -h/--help flag.
cli-chrome-help-flag = Print help

# Description of the `help` subcommand row in the Commands section.
cli-chrome-help-subcommand = Print this message or the help of the given subcommand(s)

# Help text of the argument of the `help` subcommand (the name of the command to explain).
cli-chrome-help-subcommand-arg = Print help for the subcommand(s)
