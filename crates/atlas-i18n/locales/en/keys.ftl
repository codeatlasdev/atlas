# Key names for shortcuts written out by Rust (CLI hints, notifications), used by atlas_i18n::shortcut.
# macOS shortcuts use glyphs and never read these. Modifiers stay as printed on keyboards in every language.

# Key that cancels or closes. Printed on the keycap, so it is the same in every language.
key-escape = Esc

# Key that confirms. Windows and Linux keyboards print Enter; macOS shortcuts use a glyph and never reach this message.
key-enter = Enter

# Tab key.
key-tab = Tab

# Key that deletes the character before the cursor.
key-backspace = Backspace

# Key that deletes the character after the cursor.
key-delete = Delete

# The space bar. Spelled out in pt-BR, where keyboards label it by the long bar.
key-space = Space

# Home key.
key-home = Home

# End key.
key-end = End

# Page Up key, as printed on keyboards.
key-pageup = PgUp

# Page Down key, as printed on keyboards.
key-pagedown = PgDn

# Control modifier. Windows and Linux spelling; macOS uses a glyph.
key-ctrl = Ctrl

# Alt modifier. Windows and Linux spelling; macOS uses a glyph (Option).
key-alt = Alt

# Shift modifier. Windows and Linux spelling; macOS uses a glyph.
key-shift = Shift
