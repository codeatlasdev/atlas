@@ -0,0 +1,97 @@
+//! EXPERIMENT ONLY (docs/perf/linux-webkit-study.md): environment-driven WebKitGTK knobs, to measure one at a time.
+//! Not for merging: the report lists each knob that proves worth shipping as its own PR.
+//!
+//!   ATLAS_STUDY_HWACCEL=always|never|demand     WebKitSettings:hardware-acceleration-policy
+//!   ATLAS_STUDY_CACHE=doc|web|none              WebKitWebContext cache model (document viewer / web browser / document browser)
+//!   ATLAS_STUDY_SMOOTH=0|1                      enable-smooth-scrolling
+//!   ATLAS_STUDY_WEBGL=0                         enable-webgl
+//!   ATLAS_STUDY_MEDIA=0                         enable-media, enable-webaudio, enable-mediasource, enable-media-stream
+//!   ATLAS_STUDY_PAGECACHE=0                     enable-page-cache
+//!   ATLAS_STUDY_MEMPRESSURE=limitMb:pollS:conservative:strict:kill   WebKitMemoryPressureSettings (web AND network process)
+//!   ATLAS_STUDY_TRANSPARENT=1                   the Tauri window stays transparent on Linux (what macOS does)
+
+use webkit2gtk::{
+    CacheModel, HardwareAccelerationPolicy, MemoryPressureSettings, SettingsExt, WebContextExt,
+    WebViewExt, WebsiteDataManager,
+};
+
+fn var(k: &str) -> Option<String> {
+    std::env::var(k).ok().filter(|v| !v.is_empty())
+}
+
+/// Before any WebKit process exists: memory pressure is process-wide and read when a process is spawned.
+pub fn before_window() {
+    let Some(v) = var("ATLAS_STUDY_MEMPRESSURE") else {
+        return;
+    };
+    let p: Vec<f64> = v.split(':').filter_map(|x| x.parse().ok()).collect();
+    let mut s = MemoryPressureSettings::new();
+    if let Some(&l) = p.first() {
+        s.set_memory_limit(l as u32);
+    }
+    if let Some(&x) = p.get(1) {
+        s.set_poll_interval(x);
+    }
+    if let Some(&x) = p.get(2) {
+        s.set_conservative_threshold(x);
+    }
+    if let Some(&x) = p.get(3) {
+        s.set_strict_threshold(x);
+    }
+    if let Some(&x) = p.get(4) {
+        s.set_kill_threshold(x);
+    }
+    WebsiteDataManager::set_memory_pressure_settings(&mut s);
+    crate::diag::log(&format!("study knobs: memory pressure {v}"));
+}
+
+/// Right after the webview exists, before its first load completes.
+pub fn after_window(win: &tauri::WebviewWindow) {
+    let _ = win.with_webview(|pw| {
+        let wv: webkit2gtk::WebView = pw.inner();
+        let Some(s) = WebViewExt::settings(&wv) else {
+            return;
+        };
+        let mut done = Vec::new();
+        if let Some(v) = var("ATLAS_STUDY_HWACCEL") {
+            s.set_hardware_acceleration_policy(match v.as_str() {
+                "never" => HardwareAccelerationPolicy::Never,
+                "demand" => HardwareAccelerationPolicy::OnDemand,
+                _ => HardwareAccelerationPolicy::Always,
+            });
+            done.push(format!("hwaccel={v}"));
+        }
+        if let Some(v) = var("ATLAS_STUDY_SMOOTH") {
+            s.set_enable_smooth_scrolling(v == "1");
+            done.push(format!("smooth={v}"));
+        }
+        if var("ATLAS_STUDY_WEBGL").as_deref() == Some("0") {
+            s.set_enable_webgl(false);
+            done.push("webgl=0".into());
+        }
+        if var("ATLAS_STUDY_MEDIA").as_deref() == Some("0") {
+            s.set_enable_media(false);
+            s.set_enable_webaudio(false);
+            s.set_enable_mediasource(false);
+            s.set_enable_media_stream(false);
+            done.push("media=0".into());
+        }
+        if var("ATLAS_STUDY_PAGECACHE").as_deref() == Some("0") {
+            s.set_enable_page_cache(false);
+            done.push("pagecache=0".into());
+        }
+        if let Some(v) = var("ATLAS_STUDY_CACHE")
+            && let Some(ctx) = wv.context()
+        {
+            ctx.set_cache_model(match v.as_str() {
+                "doc" => CacheModel::DocumentViewer,
+                "none" => CacheModel::DocumentBrowser,
+                _ => CacheModel::WebBrowser,
+            });
+            done.push(format!("cache={v}"));
+        }
+        if !done.is_empty() {
+            crate::diag::log(&format!("study knobs: {}", done.join(" ")));
+        }
+    });
+}
