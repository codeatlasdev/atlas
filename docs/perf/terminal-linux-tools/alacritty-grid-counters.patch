diff -r a/src/lib.rs b/src/lib.rs
--- a/alacritty_terminal-0.26.0/src/lib.rs	2026-11-23 18:38:28.003693656 -0300
+++ b/alacritty_terminal-0.26.0/src/lib.rs	2026-11-23 18:38:28.051358679 -0300
@@ -15,6 +15,12 @@
 pub mod tty;
 pub mod vi_mode;
 
+/// Scratch counters: 0 writes, 1 writes over Some(extra), 2 writes with template extra Some, 3 Cell::reset, 4 Cell::reset over Some, 5 Row::reset calls, 6 cells reset by Row::reset.
+pub static CNT: [std::sync::atomic::AtomicU64; 8] = [const { std::sync::atomic::AtomicU64::new(0) }; 8];
+#[inline(always)]
+pub fn bump(i: usize) { CNT[i].fetch_add(1, std::sync::atomic::Ordering::Relaxed); }
+
+
 pub use crate::grid::Grid;
 pub use crate::term::Term;
 pub use vte;
