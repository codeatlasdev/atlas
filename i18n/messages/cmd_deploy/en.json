	"cmd_deploy_dry_target": "target:  {name} ({host})",
	"cmd_deploy_guard_announce": "deploying {id} ({sha}) over {deployed_id} ({deployed_sha}): {delta}",
	"cmd_deploy_guard_delta_ahead": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "+{count} commit",
				"countPlural=*": "+{count} commits"
			}
		}
	],
	"cmd_deploy_guard_delta_diverged": [
		{
			"declarations": [
				"input behind",
				"local behindPlural = behind: plural"
			],
			"selectors": [
				"behindPlural"
			],
			"match": {
				"behindPlural=one": "+{ahead} / -{behind} commit (diverged)",
				"behindPlural=*": "+{ahead} / -{behind} commits (diverged)"
			}
		}
	],
	"cmd_deploy_guard_delta_downgrade": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "-{count} commit",
				"countPlural=*": "-{count} commits"
			}
		}
	],
	"cmd_deploy_guard_delta_same": "+0 commits (same commit)",
	"cmd_deploy_guard_delta_unknown": "base unknown locally",
	"cmd_deploy_guard_fetching": "deployed commit {deployed} not in this repo: git fetch origin",
	"cmd_deploy_guard_read_host_failed": "cannot read the deployed release on {host}: {error}",
	"cmd_deploy_guard_refuse_diverged": [
		{
			"declarations": [
				"input behind",
				"local behindPlural = behind: plural"
			],
			"selectors": [
				"behindPlural"
			],
			"match": {
				"behindPlural=one": "HEAD {head} and the deployed {id} @ {sha} have diverged (merge-base {base}): +{ahead} / -{behind} commit.",
				"behindPlural=*": "HEAD {head} and the deployed {id} @ {sha} have diverged (merge-base {base}): +{ahead} / -{behind} commits."
			}
		}
	],
	"cmd_deploy_guard_refuse_diverged_no_base": [
		{
			"declarations": [
				"input behind",
				"local behindPlural = behind: plural"
			],
			"selectors": [
				"behindPlural"
			],
			"match": {
				"behindPlural=one": "HEAD {head} and the deployed {id} @ {sha} have diverged (no common ancestor): +{ahead} / -{behind} commit.",
				"behindPlural=*": "HEAD {head} and the deployed {id} @ {sha} have diverged (no common ancestor): +{ahead} / -{behind} commits."
			}
		}
	],
	"cmd_deploy_guard_refuse_downgrade": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "HEAD {head} is OLDER than what is deployed ({id} @ {sha}): this would roll production back by {count} commit.",
				"countPlural=*": "HEAD {head} is OLDER than what is deployed ({id} @ {sha}): this would roll production back by {count} commits."
			}
		}
	],
	"cmd_deploy_guard_refuse_dropped": "Commits that would be dropped (git log --oneline HEAD..deployed):",
	"cmd_deploy_guard_refuse_override": "Pass {flag} to ship anyway (to go back deliberately, `atlas deploy rollback`).",
	"cmd_deploy_guard_refuse_shas": "HEAD     {head}\ndeployed {deployed}",
	"cmd_deploy_guard_refuse_unknown_base": "deployed commit {sha} ({id}) is not in this repository and could not be fetched: cannot tell whether HEAD {head} is newer.",
