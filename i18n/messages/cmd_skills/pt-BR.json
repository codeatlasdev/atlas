	"cmd_skills_install_hint": "Rode {command} para instalar todas",
	"cmd_skills_installed": "v{version} instalada",
	"cmd_skills_installed_total": [
		{
			"declarations": [
				"input count",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "Nenhuma skill instalada → {dir}",
				"countExact=*, countPlural=one": "{count} skill instalada → {dir}",
				"countExact=*, countPlural=*": "{count} skills instaladas → {dir}"
			}
		}
	],
