	"mobile_projects_search_clear": "Limpar busca",
	"mobile_projects_search_empty": "Nada corresponde a \"{query}\"",
	"mobile_projects_search_hint": "Buscar projetos, branches e pastas",
	"mobile_projects_stack_stop": "Parar",
	"mobile_projects_stack_stopping": "Parando…",
	"mobile_projects_worktrees_hide": "Ocultar worktrees",
	"mobile_projects_worktrees_show": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} worktree",
				"countPlural=*": "{count} worktrees"
			}
		}
	]
}
