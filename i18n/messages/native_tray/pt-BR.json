{
	"native_tray_capture_window_title": "Captura do Atlas",
	"native_tray_dock_hide": [
		{
			"declarations": [
				"input os"
			],
			"selectors": [
				"os"
			],
			"match": {
				"os=mac": "Ocultar Dock de Agentes",
				"os=windows": "Ocultar dock de agentes",
				"os=*": "Ocultar dock de agentes"
			}
		}
	],
	"native_tray_dock_hide_key": [
		{
			"declarations": [
				"input os"
			],
			"selectors": [
				"os"
			],
			"match": {
				"os=mac": "Ocultar Dock de Agentes  {key}",
				"os=windows": "Ocultar dock de agentes  {key}",
				"os=*": "Ocultar dock de agentes  {key}"
			}
		}
	],
	"native_tray_dock_show": [
		{
			"declarations": [
				"input os"
			],
			"selectors": [
				"os"
			],
			"match": {
				"os=mac": "Mostrar Dock de Agentes",
				"os=windows": "Mostrar dock de agentes",
				"os=*": "Mostrar dock de agentes"
			}
		}
	],
	"native_tray_dock_window_title": "Dock do Atlas",
	"native_tray_open": "Abrir o Atlas",
	"native_tray_quit": [
		{
			"declarations": [
				"input os"
			],
			"selectors": [
				"os"
			],
			"match": {
				"os=mac": "Sair do Atlas",
				"os=windows": "Sair",
				"os=*": "Sair"
			}
		}
	],
	"native_tray_toggle": [
		{
			"declarations": [
				"input os"
			],
			"selectors": [
				"os"
			],
			"match": {
				"os=mac": "Mostrar ou Ocultar o Atlas",
				"os=windows": "Mostrar ou ocultar o Atlas",
				"os=*": "Mostrar ou ocultar o Atlas"
			}
		}
	]
}
