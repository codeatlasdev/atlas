		{
			"declarations": [
				"input count",
				"input shown",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "No lines copied",
				"countExact=*, countPlural=one": "Copied {shown} line",
				"countExact=*, countPlural=*": "Copied {shown} lines"
			}
		}
	],
