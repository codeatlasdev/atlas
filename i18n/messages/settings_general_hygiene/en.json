	"settings_general_hygiene_done_ended": [
		{
			"declarations": [
				"input count",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "Ended no processes",
				"countExact=*, countPlural=one": "Ended {count} process",
				"countExact=*, countPlural=*": "Ended {count} processes"
			}
		}
	],
