{
	"sidebar_added_detected": [
		{
			"declarations": [
				"input count",
				"input stack",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "Detected {stack}: no services to run yet",
				"countExact=*, countPlural=one": "Detected {stack}: {count} service",
				"countExact=*, countPlural=*": "Detected {stack}: {count} services"
			}
		}
