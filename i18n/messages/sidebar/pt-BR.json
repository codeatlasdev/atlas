{
	"sidebar_added_detected": [
		{
			"declarations": [
				"input count",
				"input stack",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "{stack} detectado: nenhum serviço para executar ainda",
				"countExact=*, countPlural=one": "{stack} detectado: {count} serviço",
				"countExact=*, countPlural=*": "{stack} detectado: {count} serviços"
			}
		}
