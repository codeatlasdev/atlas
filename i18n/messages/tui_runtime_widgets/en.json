	"tui_runtime_widgets_health_degraded": [
		{
			"declarations": [
				"input count",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "none degraded",
				"countExact=*, countPlural=one": "{count} degraded",
				"countExact=*, countPlural=*": "{count} degraded"
			}
		}
	],
