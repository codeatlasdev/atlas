	"tui_runtime_widgets_health_degraded": [
		{
			"declarations": [
				"input count",
				"local countExact = count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countExact",
				"countPlural"
			],
			"match": {
				"countExact=0, countPlural=*": "nenhum degradado",
				"countExact=*, countPlural=one": "{count} degradado",
				"countExact=*, countPlural=*": "{count} degradados"
			}
		}
	],
