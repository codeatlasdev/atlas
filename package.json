{
	"name": "atlas",
	"private": true,
	"workspaces": {
		"packages": ["apps/*", "packages/*"],
		"catalog": {
			"typescript": "^5.7.0",
			"@types/bun": "latest",
			"zod": "^4.0.0",
			"elysia": "^1.4.0",
			"@elysiajs/cors": "^1.4.0",
			"@orpc/server": "^1.13.0",
			"@orpc/client": "^1.13.0",
			"@orpc/zod": "^1.13.0",
			"drizzle-orm": "^0.45.0",
			"drizzle-kit": "^0.31.0",
			"postgres": "^3.4.0",
			"yaml": "^2.8.2",
			"picocolors": "^1.1.1",
			"consola": "^3.4.0",
			"citty": "^0.2.0",
			"@clack/prompts": "^1.0.0",
			"@opentui/core": "^0.1.0"
		}
	},
	"type": "module",
	"engines": { "node": ">=22", "bun": ">=1.3" },
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:cli": "turbo -F cli dev",
		"dev:panel": "turbo -F panel dev",
		"dev:docs": "turbo -F docs dev",
		"db:generate": "turbo -F @atlas/db db:generate",
		"db:migrate": "turbo -F @atlas/db db:migrate",
		"db:push": "turbo -F @atlas/db db:push",
		"db:studio": "turbo -F @atlas/db db:studio",
		"db:start": "turbo -F @atlas/db db:start",
		"db:stop": "turbo -F @atlas/db db:stop",
		"db:down": "turbo -F @atlas/db db:down",
		"check": "biome check .",
		"fix": "biome check --fix .",
		"ncu": "ncu -u && for dir in apps/* packages/*; do [ -f \"$dir/package.json\" ] && (cd \"$dir\" && ncu -u); done && bun install"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "catalog:",
		"lefthook": "latest",
		"turbo": "^2.9.5",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.11"
}
