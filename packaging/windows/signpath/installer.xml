<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact configuration slug: installer. Input: the zip of the `windows-installer` job (the NSIS *-setup.exe). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="*-setup.exe" product-name="Atlas" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
