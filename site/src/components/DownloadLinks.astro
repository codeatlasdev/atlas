---
// The two primary calls to action, shared by the hero and the closing section. Both go to /download, which resolves
// the current release and the visitor's platform; an installer is never offered straight to a phone.
import { SITE } from "../data/site";
---
<a class="btn solid" href="/download/"><span class="d-full">Download Atlas</span><span class="d-short">Get Atlas</span></a>
<a class="btn" href={SITE.github} rel="noopener">Star on GitHub</a>
<style>
	.d-short { display: none; }
	@media (max-width: 720px) { .d-full { display: none; } .d-short { display: inline; } }
</style>
