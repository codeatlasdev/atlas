---
// The first screen answers "what is this?" in one read: what it does (the headline), what it is and what it is not
// (the line under it), and the product itself moving beside it. The visual is the real project panel (loop-panel,
// muted, looping); the poster is the LCP image, the video only starts after load, never under reduced motion or Data
// Saver. "Play the film" opens the full film (FilmPlayer) in a dialog, with chapters.
import InstallCopy from "./islands/InstallCopy.svelte";
import DownloadLinks from "./DownloadLinks.astro";
import FilmDialog from "./islands/FilmDialog.svelte";
import { SITE } from "../data/site";
import { mediaUrl } from "../data/landing";
import { FILM_DURATION, filmClock, filmWords } from "../data/film";

const clock = filmClock(FILM_DURATION);
const words = filmWords(FILM_DURATION);
---
<section class="hero sec" id="top" aria-labelledby="hero-h">
	<div class="wrap grid">
		<div class="copy">
			<h1 id="hero-h" class="display">Run your whole stack from one file.</h1>
			<p class="lead">Atlas starts your database, API, web app and workers in the right order, shows their health and logs in one native desktop app for macOS, Windows and Linux, and gives every AI coding agent its own branch, ports and terminal.</p>
			<p class="lead lead-s">Starts your whole stack in the right order. Gives every AI coding agent its own branch, ports and terminal.</p>
			<div class="ask" id="install">
				<div class="curl"><InstallCopy client:load cmd={SITE.install} winCmd={SITE.installWindows} /></div>
				<div class="ctas">
					<DownloadLinks />
				</div>
				<p class="ask-h">An internal developer platform that fits in one <code>atlas.yaml</code>. Open source, MIT or Apache-2.0. For macOS, Windows and Linux; on Windows, <a class="ln" href="/download/#win-h">one click with Atlas-Setup.exe</a>.</p>
				<p class="ask-h alpha"><b>Alpha:</b> it works and we use it daily, but expect bugs and breaking changes. <a href="https://github.com/codeatlasdev/atlas/issues/new">Report what breaks</a>.</p>
			</div>
		</div>

		<div class="show">
			<figure class="win clip" data-hero-clip>
				<img src={mediaUrl("loop-panel-poster.jpg")} alt="Atlas Desktop's project panel for the orbit-shop demo: five of seven services running with live CPU and memory, one that gave up after two restarts" width="1280" height="800" fetchpriority="high" decoding="async" />
				<video muted loop playsinline disablepictureinpicture preload="none" tabindex="-1" aria-hidden="true" data-hero-video>
					<source data-src={mediaUrl("loop-panel.webm")} type="video/webm" />
					<source data-src={mediaUrl("loop-panel.mp4")} type="video/mp4" />
				</video>
			</figure>
			<FilmDialog
				client:idle
				poster={mediaUrl("film-poster.jpg")}
				mp4={mediaUrl("film.mp4")}
				webm={mediaUrl("film.webm")}
				captions={mediaUrl("film.vtt")}
				thumbs={mediaUrl("film-thumbs.jpg")}
				clock={clock}
				words={words}
			>
				<span slot="fallback" class="play-static"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3.5v17l15-8.5z" /></svg>Play the film <small>{clock}</small></span>
			</FilmDialog>
		</div>
	</div>
</section>

<script>
	// Start the loop after the page has painted: the poster is already the LCP image, the video is decoration.
	// Reduced motion and Data Saver keep the poster; the loop pauses off screen and in hidden tabs.
	const fig = document.querySelector<HTMLElement>("[data-hero-clip]");
	const video = fig?.querySelector<HTMLVideoElement>("[data-hero-video]");
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
	if (fig && video && !saveData && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const start = () => {
			video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
			video.load();
			const sync = () => (document.hidden || !visible ? video.pause() : video.play().catch(() => {}));
			let visible = true;
			new IntersectionObserver(([e]) => ((visible = !!e?.isIntersecting), sync()), { threshold: 0.15 }).observe(fig);
			document.addEventListener("visibilitychange", sync);
			video.addEventListener("playing", () => (video.dataset.ready = "1"), { once: true });
			sync();
		};
		if (document.readyState === "complete") start();
		else addEventListener("load", start, { once: true });
	}
</script>

<style>
	/* One screen: svh/dvh so the iOS URL bar never causes a jump. */
	.hero {
		display: grid;
		align-content: center;
		min-height: 100vh; min-height: 100svh;
		padding: clamp(4.6rem, 10svh, 6.4rem) 0 clamp(1.4rem, 4svh, 3rem);
		overflow: clip;
	}
	/* The grid is a size container for the copy column: the headline is sized from it (cqi), so it never outgrows it. */
	.grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 3vw, 3.5rem); align-items: center; }
	.copy { display: grid; align-content: center; min-width: 0; container-type: inline-size; }
	h1 { font-size: clamp(2.4rem, min(15cqi, 10.5svh), 6.4rem); max-width: 11ch; line-height: 0.93; }
	.lead { margin-top: clamp(0.9rem, 2.4svh, 1.5rem); max-width: 42ch; color: var(--white); font-size: clamp(1.05rem, min(3.7cqi, 2.7svh), 1.3rem); }
	.ask { margin-top: clamp(1rem, 3svh, 2rem); width: min(36rem, 100%); min-width: 0; scroll-margin-top: 6rem; }
	.ctas { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.8rem; }
	.ask-h { margin: 0.8rem 0 0; font-weight: 500; font-size: 0.9rem; color: var(--fg-2); max-width: 46ch; }
	.ask-h code { background: rgb(255 255 255 / 0.14); }
	.ask-h.alpha { margin-top: 0.4rem; font-size: 0.84rem; }
	.ask-h.alpha b { color: var(--wait); }
	.ask-h.alpha a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

	.lead-s { display: none; }
	.show { position: relative; min-width: 0; display: grid; gap: 0.8rem; margin-right: calc(-1 * clamp(0px, 5vw, 6rem)); }
	/* The aspect box is reserved before any byte arrives (the poster and the video share it): no layout shift. */
	.clip { position: relative; margin: 0; aspect-ratio: 16 / 10; max-height: calc(100svh - 12rem); width: 100%; }
	.clip img, .clip video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
	.clip video { opacity: 0; transition: opacity 0.3s; }
	.clip video[data-ready] { opacity: 1; }
	.play-static { display: inline-flex; align-items: center; gap: 0.6rem; }

	/* Short desktop windows (1280x720): the fold is the product, so the small print goes */
	@media (max-height: 760px) and (min-width: 961px) { .ask-h { display: none; } .ask-h.alpha { display: block; } }

	/* Tablet and phones: copy first, product right under it at its natural height; the curl line needs a terminal, so it lives on /download. */
	@media (max-width: 960px) {
		.hero { min-height: 0; display: block; padding: calc(var(--bar-h) + clamp(0.4rem, 2svh, 1.4rem)) 0 clamp(2.4rem, 8vw, 4rem); }
		.grid { grid-template-columns: 1fr; align-items: stretch; gap: clamp(1rem, 3.4vw, 1.6rem); }
		/* copy and product share one flow; on phones the product comes straight after the headline and the one-line pitch, so it is on the first screen */
		.copy { display: contents; }
		.show { order: 2; margin-right: 0; }
		.ask { order: 3; }
		h1 { font-size: clamp(2.5rem, 9.6vw, 5.4rem); max-width: 14ch; }
		.lead { font-size: 1.125rem; line-height: 1.42; max-width: 40ch; margin-top: 0.7rem; }
	}
	@media (max-width: 640px) {
		.grid { display: flex; flex-direction: column; align-items: stretch; width: min(var(--max), 100% - 2 * var(--gutter) - env(safe-area-inset-left) - env(safe-area-inset-right)); }
		h1 { font-size: clamp(2.3rem, 11.2vw, 3.2rem); max-width: none; line-height: 0.94; }
		.lead { display: none; }
		.lead-s { display: block; font-size: 1.0625rem; line-height: 1.4; margin-top: 0.6rem; max-width: 34ch; }
		.curl { display: none; }
		.ctas { flex-direction: column; gap: 0.7rem; margin-top: 0; }
		.ctas :global(.btn) { width: 100%; min-height: 52px; font-size: 1.0625rem; padding: 0.9rem 1rem; }
		.ask { margin-top: 0.4rem; width: 100%; }
		.ask-h:not(.alpha) { font-size: 0.9375rem; line-height: 1.5; }
		.ask-h.alpha { font-size: 0.875rem; line-height: 1.5; }
	}
	@media (max-width: 960px) and (max-height: 500px) and (orientation: landscape) {
		.grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
		h1 { font-size: clamp(2rem, 9cqi, 3rem); }
		.curl, .ask-h:not(.alpha) { display: none; }
		.ctas { flex-direction: row; }
	}
</style>
