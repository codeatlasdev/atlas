---
// Labels: you_say, phrase_ok, out_ok, phrase_more, out_more, always_tap
// Moment: the waveform bars rise once, left to right.
interface Props { labels: Record<string, string>; alt: string }
const { labels, alt } = Astro.props;
const bars = Array.from({ length: 30 }, (_, i) => ({
	h: (0.22 + 0.78 * Math.abs(Math.sin(i * 0.8) * Math.cos(i * 0.35))).toFixed(2),
	i,
}));
---
<div class="art art-a27-voice" role="img" aria-label={alt}>
	<div class="wave">
		<span class="mic">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="12" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
		</span>
		<span class="bars">
			{bars.map((b) => <i class="bar part" style={`--h:${b.h};--i:${b.i}`}></i>)}
		</span>
		<span class="say-label">{labels.you_say}</span>
	</div>
	<div class="row">
		<span class="said">{labels.phrase_ok}</span>
		<svg class="arrow" viewBox="0 0 24 12" width="24" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 6h20M15 1l5 5-5 5"></path></svg>
		<span class="out"><i class="d go"></i>{labels.out_ok}</span>
	</div>
	<div class="row">
		<span class="said">{labels.phrase_more}</span>
		<svg class="arrow" viewBox="0 0 24 12" width="24" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M0 6h20M15 1l5 5-5 5"></path></svg>
		<span class="out"><i class="d wait"></i>{labels.out_more}</span>
	</div>
	<div class="always">
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
		<span>{labels.always_tap}</span>
	</div>
</div>

<style>
	.art { container-type: inline-size; display: grid; gap: 0.75rem; font-family: var(--font); color: var(--ink); }
	.wave { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
	.mic { flex: none; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--blue); color: var(--white); }
	.bars { flex: 1 1 10rem; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 2px; height: 2.6rem; }
	.bar { flex: 1 1 0; max-width: 6px; height: calc(var(--h) * 100%); border-radius: 3px; background: var(--blue); }
	.say-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
	.row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 0.6rem; }
	.arrow { color: var(--ink-2); }
	.said { border: 1.5px solid var(--ink); border-radius: 0.6rem 0.6rem 0.6rem 0.1rem; background: var(--paper); padding: 0.4rem 0.7rem; font-family: var(--mono); font-size: 0.85rem; line-height: 1.35; overflow-wrap: anywhere; }
	.said::before { content: "\201C"; }
	.said::after { content: "\201D"; }
	.out { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; font-weight: 600; line-height: 1.3; }
	.d { flex: none; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1px solid var(--ink); }
	.d.go { background: var(--go); }
	.d.wait { background: var(--wait); }
	.always { display: flex; align-items: flex-start; gap: 0.5rem; background: var(--ink); color: var(--white); border-radius: 0.5rem; padding: 0.7rem 0.9rem; font-size: 0.9rem; line-height: 1.4; }
	.always svg { flex: none; margin-top: 0.1rem; }
	@container (max-width: 30rem) {
		.row { grid-template-columns: 1fr; gap: 0.35rem; }
		.arrow { transform: rotate(90deg); margin-left: 0.8rem; }
	}

	@keyframes rise { from { transform: scaleY(0.12); } }
	@media (prefers-reduced-motion: no-preference) {
		:global(html.js) .art.play .bar { animation: rise 0.6s ease-out both; animation-delay: calc(var(--i) * 0.03s); }
	}
</style>
