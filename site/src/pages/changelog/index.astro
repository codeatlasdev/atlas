---
import Base from "../../layouts/Base.astro";
import { Content } from "../../../../CHANGELOG.md";
---
<Base ground="paper" title="Changelog · Atlas" description="Every Atlas release: CLI, TUI, MCP server and Atlas Desktop.">
	<div class="wrap page">
		<article class="prose"><h1 class="display">Changelog</h1><Content /></article>
	</div>
</Base>
<style>
	.page { max-width: 820px; padding: 7rem 0 4rem; }
	.prose { min-width: 0; overflow-wrap: break-word; }
	.prose h1 { font-family: var(--font); font-weight: 800; font-stretch: 68%; letter-spacing: -0.012em; line-height: 0.92; text-wrap: balance; font-size: clamp(2.6rem, 6vw, 4.6rem); margin: 0 0 1.6rem; }
	.prose :global(h2) { font-weight: 800; font-stretch: 75%; font-size: 2rem; line-height: 1.05; margin: 3.2rem 0 1rem; padding-top: 0.8rem; border-top: 2px solid var(--fg); }
	.prose :global(h3) { font-weight: 800; font-stretch: 80%; font-size: 1.1rem; margin: 2rem 0 0.6rem; }
	.prose :global(p), .prose :global(li) { color: var(--fg-2); font-size: 1rem; line-height: 1.65; }
	.prose :global(li) { margin: 0.45rem 0; }
	.prose :global(strong) { color: var(--fg); }
	.prose :global(code) { background: rgb(12 16 56 / 0.08); color: var(--fg); padding: 0.1em 0.38em; border-radius: 0; font-size: 0.86em; }
	.prose :global(a) { color: var(--fg); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.2em; }
	.prose :global(.anchor) { display: none; }
	.prose :global(:not(pre) > code) { overflow-wrap: anywhere; }
	.prose :global(pre) { overflow-x: auto; max-width: 100%; }
	.prose :global(table) { display: block; overflow-x: auto; max-width: 100%; }
	@media (max-width: 760px) {
		.page { padding: calc(5.5rem + env(safe-area-inset-top)) 0 3rem; }
		.prose :global(h2) { font-size: 1.75rem; margin-top: 2.6rem; }
		.prose :global(p), .prose :global(li) { font-size: 1.0625rem; line-height: 1.65; }
		.prose :global(a) { padding-block: 0.45em; }
		.prose :global(li) { margin: 0.2rem 0; }
		.prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
	}
</style>
