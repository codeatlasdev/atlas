---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docAlternates, editUrl, loadNav, titleOf } from "../../lib/docs";

export async function getStaticPaths() {
	const { groups, entries, translations } = await loadNav();
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, groups, state: translations.get(entry.id)!.state } }));
}

const { entry, groups, state } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const title = entry.data.title ?? remarkPluginFrontmatter.title ?? titleOf(entry);
---
<DocsLayout
	title={title}
	description={entry.data.description}
	slug={entry.id}
	groups={groups}
	headings={headings}
	editUrl={editUrl(entry)}
	alternates={docAlternates(entry.id, state)}
>
	<Content />
</DocsLayout>
