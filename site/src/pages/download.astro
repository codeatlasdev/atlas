---
import Base from "../layouts/Base.astro";
import InstallCopy from "../components/islands/InstallCopy.svelte";
import Waitlist from "../components/islands/Waitlist.svelte";
import ShareLink from "../components/islands/ShareLink.svelte";
import { channelReleases, latestRelease, fmtDate, fmtSize } from "../data/release";
import { SITE } from "../data/site";
import { DEFAULT_CHANNEL, type Channel } from "../../functions/_lib/channels";
import copy from "../../../crates/atlas-core/data/channels.json";

// The primary download is the DEFAULT channel (Alpha until a real Stable exists); the other channels are cards below it. The copy is
// the one the CLI and Atlas Desktop use; what each offers is resolved like the edge does it.
const others = await channelReleases();
const main = copy.channels.find((c) => c.id === DEFAULT_CHANNEL)!;
const otherChannels = copy.channels.filter((c) => c.id !== DEFAULT_CHANNEL);

const rel = await latestRelease();
const dmgUrl = rel.dmg?.url ?? SITE.releases;
const dmgLabel = rel.version ? `Atlas ${rel.version} for Apple silicon` : "Latest release on GitHub";
// The Windows one-click installer is a release asset with a fixed name, so GitHub's own /releases/latest/download/ redirect always
// points at the newest build of the default channel (the release "Latest" is): no manifest entry or version in the URL needed.
const winUrl = `${SITE.releases}/download/Atlas-Setup.exe`;
const winPs = SITE.installWindows;
const desc = "Download Atlas for macOS (Apple silicon), Windows 10/11 (x64, one-click Atlas-Setup.exe) and Linux x86_64 (Arch, .deb, .rpm, AppImage). Intel Macs, Windows on Arm and Linux on Arm are coming soon.";

// Platforms that are not shipped yet. `topic` is stored with the email by /api/waitlist.
const soon = [
	{ topic: "macos-intel", name: "macOS, Intel", note: "x86-64 Macs", icon: `<path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/><path d="M10 2c1 .5 2 2 2 5"/>` },
	{ topic: "windows", name: "Windows on Arm", note: "native arm64 (the x64 build runs emulated today)", icon: `<rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/>` },
	{ topic: "linux", name: "Linux on Arm", note: "aarch64: AppImage, .deb, .rpm and Arch", icon: `<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>` },
];
// What each shipped platform needs. The last row is shared by all three.
const reqs: [string, string][] = [
	["macOS", "13 Ventura or later, Apple silicon (M1 or later)"],
	["Windows", "10 (1809 or newer) or 11, x64 (Arm PCs run it emulated); WebView2, preinstalled on Windows 11"],
	["Linux", "x86_64, glibc 2.35+ (Arch, Fedora, Debian 12, Ubuntu 22.04 or newer); WebKitGTK 4.1"],
	["Optional", "git and gh for worktrees and pull requests; Docker (OrbStack or Docker Desktop) for an infra: block"],
];
---
<Base title="Download Atlas" description={desc} jsonLd={{
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Atlas",
	applicationCategory: "DeveloperApplication",
	operatingSystem: ["macOS 13+ (Apple silicon)", "Windows 10 (1809+) and 11 (x64)", "Linux x86_64 (glibc 2.35+)"],
	softwareVersion: rel.version || undefined,
	datePublished: rel.date || undefined,
	downloadUrl: dmgUrl,
	url: `${SITE.url}/download/`,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
	license: ["https://opensource.org/licenses/MIT", "https://opensource.org/licenses/Apache-2.0"],
}}>
	<section class="dl sec" aria-labelledby="dl-h">
		<div class="wrap">
			<header class="head">
				<h1 id="dl-h" class="display">Get Atlas.</h1>
				<p class="lead">The desktop app and the <code>atlas</code> command line, in one download. Free and open source.</p>
			</header>

			<section class="phone" aria-labelledby="phone-h" data-phone hidden>
				<h2 id="phone-h" class="h">On your phone?</h2>
				<p class="sub">Atlas runs on a computer. Send yourself the link and open it there.</p>
				<ShareLink client:visible url={`${SITE.url}/download/`} />
			</section>

			<!-- Three platforms ship today. The page is complete without JS (macOS, Windows, Linux side by side); the script only flags the visitor's own card and puts it first -->
			<div class="plats" data-plats data-default-channel={DEFAULT_CHANNEL}>
				<article class="plat primary" aria-labelledby="mac-h" data-card="macos-arm">
					<div class="top">
						<span class="badge"><i class="dot go"></i> Available now</span>
						<span class="you" data-you hidden>Your Mac</span>
					</div>
					<h2 id="mac-h" class="display">macOS</h2>
					<p class="sub" data-label>{dmgLabel}</p>
					<div class="cta">
						<a class="btn solid big" href={dmgUrl} rel="noopener" data-dmg>Download for Mac (.dmg)</a>
						<span class="meta" data-size>{rel.dmg ? `${fmtSize(rel.dmg.size)} · Apple silicon` : "Apple silicon"}</span>
					</div>
					<p class="note" data-intel hidden>This download is for Apple silicon. Intel Macs are coming soon: use Notify me below.</p>
					<div class="cli">
						<p class="cli-h">Or install the command line and the app from a terminal</p>
						<InstallCopy client:load cmd={SITE.install} />
						<p class="fine">Then run <code>atlas desktop</code> to install the app. <a class="ln" href="/docs/installation/">Install guide</a></p>
					</div>
				</article>

				<article class="plat primary" aria-labelledby="win-h" data-card="windows">
					<div class="top">
						<span class="badge"><i class="dot go"></i> Available now</span>
						<span class="you" data-you hidden>Your PC</span>
					</div>
					<h2 id="win-h" class="display">Windows</h2>
					<p class="sub">Windows 10 (1809+) and 11, x64. Per-user, no admin rights.</p>
					<div class="cta">
						<a class="btn solid big" href={winUrl} rel="noopener" data-exe>Download for Windows (.exe)</a>
						<span class="meta">Atlas-Setup.exe · one click</span>
					</div>
					<p class="note smart" data-smartscreen>Not code-signed yet: Windows SmartScreen may say "Windows protected your PC". Click <b>More info</b>, then <b>Run anyway</b>. Code signing through SignPath Foundation is pending (<a class="ln" href="/code-signing-policy/">Code signing policy</a>); the <a class="ln" href="#sum-h">SHA-256</a> of the file is on the release page.</p>
					<div class="cli">
						<p class="cli-h">Or install the command line and the app from PowerShell</p>
						<InstallCopy client:load cmd={winPs} prompt=">" label="Copy PowerShell install command" />
						<p class="fine">Then run <code>atlas desktop</code> to install the app. <a class="ln" href="/docs/installation/#windows">Windows guide</a></p>
					</div>
				</article>

				<article class="plat primary" aria-labelledby="lin-h" data-card="linux">
					<div class="top">
						<span class="badge"><i class="dot go"></i> Available now</span>
						<span class="you" data-you hidden>Your Linux</span>
					</div>
					<h2 id="lin-h" class="display">Linux</h2>
					<p class="sub">x86_64: Arch, Debian, Ubuntu, Fedora and more.</p>
					<div class="cta">
						<a class="btn solid big" href={SITE.releases} rel="noopener">Get packages (.deb, .rpm, AppImage)</a>
						<span class="meta">Arch package too</span>
					</div>
					<div class="cli">
						<p class="cli-h">Or install the command line and the app from a terminal</p>
						<InstallCopy client:load cmd={SITE.install} />
						<p class="fine">Then run <code>atlas desktop</code>. <a class="ln" href="/docs/installation/#linux-packages">Linux packages</a></p>
					</div>
				</article>
			</div>

			<div class="grid">
				<div class="chan-note">
					{copy.stage === "alpha" && <p class="stage" data-stage>{copy.stage_note}</p>}
					<p class="stage" data-primary-channel>These downloads are the <b>{main.label}</b> channel: {main.promise}</p>
					<p class="stage">Terminals in Atlas Desktop are the native GPU terminal on macOS and xterm.js on Windows and Linux. Capture and recording, and the agent test instances, are macOS only.</p>
				</div>

				<aside class="side" aria-label="This release">
					<dl class="facts">
						<div><dt>Version</dt><dd>{rel.version ? <a class="ln" href={rel.notes} rel="noopener" data-ver>{rel.version}</a> : <a class="ln" href={rel.notes} rel="noopener" data-ver>Latest</a>}</dd></div>
						<div><dt>Released</dt><dd><time data-date datetime={rel.date || undefined}>{rel.date ? fmtDate(rel.date) : "Latest release"}</time></dd></div>
						<div><dt>Notes</dt><dd><a class="ln" href="/changelog/">Changelog</a>{" "}<a class="ln" href={rel.notes} rel="noopener" data-notes>Release page</a></dd></div>
						<div><dt>License</dt><dd>MIT or Apache-2.0</dd></div>
					</dl>
					<h3>System requirements</h3>
					<dl class="facts req">
						{reqs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
					</dl>
				</aside>
			</div>

			<section class="channels" aria-labelledby="ch-h" data-channels>
				<h2 id="ch-h" class="h">Other channels</h2>
				<p class="sub">The downloads above are the {main.label} channel{DEFAULT_CHANNEL === "stable" ? "" : ", the default while Atlas is in alpha"}. {DEFAULT_CHANNEL === "stable" ? "Beta and Alpha get new work sooner and break more often." : "Beta and Stable move slower and break less: Stable only ships builds that already ran as a beta."} You can switch at any time with <code>atlas update channel</code> or in Settings. The cards below link the macOS <code>.dmg</code>; for Windows or Linux, open the release page of the channel you want.</p>
				<ul class="cards">
					{otherChannels.map((c) => {
						const r = others[c.id as Channel] ?? null;
						return (
							<li class="card chan" data-channel={c.id} data-risk={c.risk}>
								<div class="chan-t">
									<h3 id={`ch-${c.id}`}>{c.label}</h3>
									<span class={`badge risk risk-${c.risk}`}>{c.risk_label}</span>
									<p class="pn">{c.audience}</p>
								</div>
								<p class="promise">{c.promise}</p>
								<div class="chan-r" data-offer aria-live="polite">
									{r ? (
										<>
											<p class="chan-v"><a class="ln" href={r.notes} rel="noopener" data-ver>{r.version}</a> · <time data-date datetime={r.date}>{fmtDate(r.date)}</time></p>
											{r.dmg ? <a class="btn" href={r.dmg.url} rel="noopener" data-dmg>Download {c.label} (.dmg)</a> : null}
											{r.dmg ? <p class="meta">{fmtSize(r.dmg.size)} · Apple silicon · SHA-256 <code data-sha>{r.dmg.sha256}</code></p> : null}
										</>
									) : (
										<p class="chan-none" data-none>No {c.label} release yet.</p>
									)}
								</div>
								<p class="fine chan-sw">{c.switch_to}</p>
							</li>
						);
					})}
				</ul>
			</section>

			<section class="soon" aria-labelledby="soon-h">
				<h2 id="soon-h" class="h">Coming soon</h2>
				<p class="sub">Atlas is built to run anywhere you write code. Tell us where you want it and we will email you when it ships.</p>
				<ul class="cards">
					{soon.map((p) => (
						<li class="card" data-card={`soon-${p.topic}`}>
							<div class="ct">
								<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
								<div>
									<h3>{p.name}</h3>
									<p class="pn">{p.note}</p>
								</div>
								<span class="badge soon-b">Coming soon</span>
							</div>
							<Waitlist client:visible variant="close" topic={p.topic} id={p.topic} cta="Notify me" title="We will tell you." done={`One email when Atlas for ${p.name} ships.`} />
						</li>
					))}
				</ul>
				<p class="fine src">Windows on Arm runs the x64 build emulated today. Intel Macs and Linux on Arm have no prebuilt binaries yet; the CLI builds from source meanwhile: <a class="ln" href="/docs/installation/#build-from-source">build from source</a>.</p>
			</section>

			<section class="verify" aria-labelledby="sum-h">
				<h2 id="sum-h" class="h">Verify your download</h2>
				<p class="sub">SHA-256, read from the latest release. Check with <code>shasum -a 256 &lt;file&gt;</code> (Linux: <code>sha256sum</code>; Windows PowerShell: <code>Get-FileHash -Algorithm SHA256 &lt;file&gt;</code>). Every asset on the <a class="ln" href={SITE.releases} rel="noopener" data-notes>release page</a>, <code>Atlas-Setup.exe</code> included, also has a <code>.sha256</code> file next to it.</p>
				<dl class="sums" data-sums hidden={!(rel.dmg && rel.cli)}>
					<div><dt data-n="dmg">{rel.dmg?.name}</dt><dd><code data-s="dmg">{rel.dmg?.sha256}</code></dd></div>
					<div><dt data-n="cli">{rel.cli?.name}</dt><dd><code data-s="cli">{rel.cli?.sha256}</code></dd></div>
				</dl>
			</section>
		</div>
	</section>
</Base>

<script>
	// Detects the visitor's OS and chip and adjusts the page: their platform card gets a "Your ..." label and moves first, Intel Macs
	// get an honest note, phones get the send-me-the-link block. Works without it: the static page already shows macOS, Windows and Linux.
	type UAData = { platform?: string; mobile?: boolean; getHighEntropyValues?: (h: string[]) => Promise<{ architecture?: string; bitness?: string }> };
	const nav = navigator as Navigator & { userAgentData?: UAData };
	const ua = navigator.userAgent;
	const uad = nav.userAgentData;
	const mobile = uad?.mobile ?? /Android|iPhone|iPad|iPod|Mobile/i.test(ua);
	const plat = (uad?.platform ?? navigator.platform ?? "").toLowerCase();
	const os = mobile ? "mobile" : /mac/.test(plat) || /Macintosh/.test(ua) ? "mac" : /win/.test(plat) ? "windows" : /linux|cros|x11/.test(plat) || /Linux/.test(ua) ? "linux" : "other";
	const root = document.documentElement;
	root.dataset.os = os;

	const show = (sel: string, on = true) => document.querySelectorAll<HTMLElement>(sel).forEach((el) => (el.hidden = !on));
	if (os === "mobile") show("[data-phone]");
	// The visitor's own card: labelled, and first in the list (CSS `order`, so the DOM and the tab order stay the same).
	const card = { mac: "macos-arm", windows: "windows", linux: "linux" }[os as "mac" | "windows" | "linux"];
	const mine = card ? document.querySelector<HTMLElement>(`.plat[data-card="${card}"]`) : null;
	if (mine) {
		mine.dataset.you = "";
		mine.querySelector<HTMLElement>("[data-you]")?.removeAttribute("hidden");
	}

	// Apple silicon vs Intel: only Chromium exposes the architecture; Safari hides it, so for Safari we say nothing rather than guess.
	if (os === "mac" && uad?.getHighEntropyValues) {
		uad.getHighEntropyValues(["architecture"]).then((v) => {
			if (v.architecture === "x86") {
				mine?.querySelector<HTMLElement>("[data-you]")?.setAttribute("hidden", "");
				delete mine?.dataset.you;
				show("[data-intel]");
				document.querySelector('[data-card="soon-macos-intel"]')?.setAttribute("data-you", "");
			}
		}).catch(() => {});
	}

	// Live release: the page is built once, but the numbers on it come from the edge (/release.json, resolved from the latest GitHub
	// release and cached for about a minute), so a release shows here without a site deploy. The built values are only the first paint.
	interface Asset { name: string; url: string; sha256: string; size: number }
	interface Rel { tag: string; version: string; date: string; notes: string; dmg?: Asset; cli?: Asset }
	const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
	const apply = (r: Rel) => {
		if (!r.version) return;
		const btn = $<HTMLAnchorElement>("[data-dmg]");
		if (btn && r.dmg) btn.href = r.dmg.url;
		const label = $("[data-label]");
		if (label) label.textContent = `Atlas ${r.version} for Apple silicon`;
		const size = $("[data-size]");
		if (size && r.dmg) size.textContent = `${(r.dmg.size / 1_048_576).toFixed(1)} MB · Apple silicon`;
		const ver = $<HTMLAnchorElement>("[data-ver]");
		if (ver) { ver.textContent = r.version; ver.href = r.notes; }
		document.querySelectorAll<HTMLAnchorElement>("[data-notes]").forEach((a) => (a.href = r.notes));
		const t = $<HTMLTimeElement>("[data-date]");
		if (t && r.date) { t.dateTime = r.date; t.textContent = new Date(`${r.date}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }); }
		if (r.dmg && r.cli) {
			for (const [k, a] of [["dmg", r.dmg], ["cli", r.cli]] as const) {
				const n = $(`[data-n="${k}"]`), s = $(`[data-s="${k}"]`);
				if (n) n.textContent = a.name;
				if (s) s.textContent = a.sha256;
			}
			const sums = $("[data-sums]");
			if (sums) sums.hidden = false;
		}
		document.documentElement.dataset.release = r.version;
	};
	// Other channels: /channels.json carries the same copy as the page and what each channel offers right now. A channel other than
	// Stable that offers nothing newer than Stable ("release" is Stable's own tag) shows the honest empty state instead of repeating the
	// Stable download. The default channel is the primary card (hydrated from /release.json), so it is skipped here.
	interface Chan { id: string; label: string; release: (Rel & { tag: string }) | null }
	const defaultChannel = document.querySelector<HTMLElement>("[data-default-channel]")?.dataset.defaultChannel;
	const fmt = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
	const offer = (c: Chan, stable: string | undefined) => {
		const box = $(`[data-channel="${c.id}"] [data-offer]`);
		if (!box) return;
		const r = c.release;
		box.replaceChildren();
		const add = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, fill: (el: HTMLElementTagNameMap[K]) => void) => {
			const el = document.createElement(tag);
			if (cls) el.className = cls;
			fill(el);
			box.append(el);
			return el;
		};
		if (!r || (c.id !== "stable" && r.tag === stable)) {
			add("p", "chan-none", (p) => { p.dataset.none = ""; p.textContent = `No ${c.label} release yet.`; });
			return;
		}
		add("p", "chan-v", (p) => {
			const a = document.createElement("a");
			a.className = "ln"; a.href = r.notes; a.rel = "noopener"; a.textContent = r.version; a.dataset.ver = "";
			const t = document.createElement("time");
			t.dateTime = r.date; t.textContent = fmt(r.date); t.dataset.date = "";
			p.append(a, " · ", t);
		});
		if (r.dmg) {
			const d = r.dmg;
			add("a", "btn", (a) => { a.href = d.url; a.rel = "noopener"; a.textContent = `Download ${c.label} (.dmg)`; a.dataset.dmg = ""; });
			add("p", "meta", (p) => {
				const code = document.createElement("code");
				code.dataset.sha = ""; code.textContent = d.sha256;
				p.append(`${(d.size / 1_048_576).toFixed(1)} MB · Apple silicon · SHA-256 `, code);
			});
		}
	};
	fetch("/channels.json", { headers: { accept: "application/json" } })
		.then((r) => (r.ok ? (r.json() as Promise<{ channels: Chan[] }>) : Promise.reject()))
		.then(({ channels }) => {
			const stable = channels.find((c) => c.id === "stable")?.release?.tag;
			for (const c of channels) if (c.id !== defaultChannel) offer(c, stable);
		})
		.catch(() => {
			// Same as /release.json: the built cards stay.
		});
	fetch("/release.json", { headers: { accept: "application/json" } })
		.then((r) => (r.ok ? (r.json() as Promise<Rel>) : Promise.reject()))
		.then(apply)
		.catch(() => {
			// /release.json is same-origin and serves its last good copy when GitHub is down; if even that fails, the built values stay.
		});
</script>

<style>
	.dl { padding: clamp(5rem, 10vw, 7rem) 0 var(--s-7); }
	.head { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); }
	h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
	.lead { max-width: 40ch; color: var(--white); }
	.h { font: 800 clamp(1.5rem, 3.2vw, 2.1rem)/1.05 var(--font); font-stretch: 72%; letter-spacing: -0.005em; margin: 0; }
	.sub { margin: 0; color: var(--fg-2); max-width: 56ch; }
	.fine { margin: 0.9rem 0 0; color: var(--fg-2); font-size: 0.95rem; }
	.badge { display: inline-flex; align-items: center; gap: 0.5rem; font: 700 0.82rem/1 var(--font); padding: 0.4rem 0.7rem; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--blue-line); white-space: nowrap; }
	.soon-b { color: var(--wait); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--wait) 55%, transparent); }

	.grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 1fr); gap: var(--s-5); align-items: start; }
	/* The three shipped platforms side by side; the visitor's own card (flagged by the script) comes first and gets the same ring as a .card[data-you] */
	.plats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--s-4); align-items: start; margin-bottom: var(--s-5); }
	.plat { align-content: start; }
	.plat[data-you] { order: -1; box-shadow: 0 0 0 2px var(--wait), 0 30px 60px -30px rgb(2 4 50 / 0.8); }
	.plat h2 { font-size: clamp(2.2rem, 4.5vw, 3.2rem); }
	.plat .btn.big { padding: 0.95rem 1.3rem; font-size: 1rem; }
	.smart { font-size: 0.92rem; font-weight: 500; color: var(--fg-2); padding: 0.7rem 0.9rem; border-radius: 8px; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--wait) 55%, transparent); }
	.smart b { color: var(--fg); }
	.chan-note { display: grid; gap: var(--s-2); align-content: start; min-width: 0; }
	.primary { display: grid; gap: var(--s-3); padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--blue-deep); border-radius: 12px; box-shadow: 0 0 0 1px var(--blue-line), 0 30px 60px -30px rgb(2 4 50 / 0.8); min-width: 0; }
	.primary .top { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); }
	.primary h2 { font-size: clamp(2.6rem, 6vw, 4.2rem); }
	.you { font: 700 0.82rem/1 var(--font); color: var(--ink); background: var(--go); padding: 0.4rem 0.65rem; border-radius: 999px; }
	.cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: var(--s-2); }
