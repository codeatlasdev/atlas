---
// Every docs page exists under /pt-br/docs/<slug>/. A translated page (docs/pt-BR/<slug>.md) shows the translation, with a banner
// when the English file changed since. A page without one shows the English body, a banner, lang="en" on the article, a canonical
// link to the English page and no hreflang, no sitemap entry and no search index entry (it is a copy, not a translation).
import { render } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { docAlternates, editUrl, loadNav, titleOf } from "../../../lib/docs";
import { docPath } from "../../../lib/i18n";

export async function getStaticPaths() {
	const { groups, entries, translations } = await loadNav("pt-BR");
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, groups, ...translations.get(entry.id)! } }));
}

const { entry, groups, translation, state } = Astro.props;
// A translation renders its own markdown (`title` from its front matter); otherwise the English entry renders.
const shown = translation ?? entry;
const { Content, headings, remarkPluginFrontmatter } = await render(shown);
const title = translation ? translation.data.title : (entry.data.title ?? remarkPluginFrontmatter.title ?? titleOf(entry));
---
<DocsLayout
	title={title}
	description={translation ? undefined : entry.data.description}
	slug={entry.id}
	groups={groups}
	headings={headings}
	editUrl={editUrl(shown)}
	state={state}
	contentLang={translation ? undefined : "en"}
	alternates={docAlternates(entry.id, state)}
	canonicalPath={translation ? undefined : docPath(entry.id, "en")}
>
	<Content />
</DocsLayout>
