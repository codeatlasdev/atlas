{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src", "films", "scripts"]
}
